{
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*",
		"eslint.config.*"
	],
	"compilerOptions": {
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"paths": {
			"@/*": ["./src/*"]
		},
		"module": "es2020",
		"moduleResolution": "Bundler",
		"types": ["node", "@vue/test-utils"]
	}
}
